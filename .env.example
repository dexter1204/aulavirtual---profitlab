# URL base de la API PHP.
# - Si el frontend y la API están en el MISMO dominio (recomendado),
#   déjalo como /api  (ruta relativa).
# - Si la API está en otro dominio, pon la URL completa, ej:
#   https://api.tudominio.com
NEXT_PUBLIC_API_URL=/api
