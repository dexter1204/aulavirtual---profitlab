# ============================================================
# Profit Lab · Aula Virtual — configuración Apache para SiteGround
# Este archivo se copia automáticamente a la carpeta out/ al hacer el build.
# ============================================================

# Página de error personalizada (export estático de Next.js)
ErrorDocument 404 /404.html

# Forzar HTTPS (descomenta si tu dominio ya tiene certificado SSL activo)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Compresión GZIP ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Caché de recursos estáticos ---
<IfModule mod_expires.c>
  ExpiresActive On
  # Los assets de Next (/_next/static) llevan hash: cachear 1 año
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # El HTML no se cachea de forma agresiva
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
